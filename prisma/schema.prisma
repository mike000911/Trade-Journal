generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Session {
  PREMARKET
  OPEN
  MIDDAY
  POWER_HOUR
  AFTER_HOURS
}

enum Direction {
  LONG
  SHORT
}

enum Emotion {
  CALM
  FOCUSED
  HESITANT
  FOMO
  REVENGE
  OVERCONFIDENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String?
  timezone     String   @default("America/New_York")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  trades       Trade[]
  weeklyNotes  WeeklyReview[]
}

model Trade {
  id               String    @id @default(cuid())
  userId           String
  date             DateTime
  symbol           String
  session          Session
  direction        Direction
  entry            Decimal   @db.Decimal(12, 4)
  exit             Decimal   @db.Decimal(12, 4)
  stopLoss         Decimal?  @db.Decimal(12, 4)
  takeProfit       Decimal?  @db.Decimal(12, 4)
  positionSize     Int
  pnl              Decimal   @db.Decimal(12, 2)
  rMultiple        Decimal?  @db.Decimal(8, 2)
  setupType        String
  bias             String?
  liquidityTarget  String?
  entryReason      String?
  exitReason       String?
  emotion          Emotion?
  ruleAdherence    Int?
  mistakeType      String?
  lesson           String?
  screenshots      TradeScreenshot[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([symbol])
}

model TradeScreenshot {
  id        String   @id @default(cuid())
  tradeId   String
  url       String
  caption   String?
  createdAt DateTime @default(now())

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

model WeeklyReview {
  id              String   @id @default(cuid())
  userId          String
  weekStart       DateTime
  weekEnd         DateTime
  userNotes       String?
  aiSummary       String?
  strengths       String[]
  weaknesses      String[]
  repeatedMistakes String[]
  actionPoints    String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart, weekEnd])
}
