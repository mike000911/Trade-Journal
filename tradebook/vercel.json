{
  "version": 2,
  "functions": {
    "api/handler.mjs": {
      "includeFiles": "journal/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/handler?route=/"
    },
    {
      "source": "/login",
      "destination": "/api/handler?route=/login"
    },
    {
      "source": "/api/journal",
      "destination": "/api/handler?route=/api/journal"
    },
    {
      "source": "/api/images",
      "destination": "/api/handler?route=/api/images"
    },
    {
      "source": "/api/images/:id",
      "destination": "/api/handler?route=/api/images/:id"
    },
    {
      "source": "/api/login",
      "destination": "/api/handler?route=/api/login"
    },
    {
      "source": "/api/logout",
      "destination": "/api/handler?route=/api/logout"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "outputDirectory": "public",
  "framework": null,
  "buildCommand": "",
  "regions": [
    "fra1"
  ]
}
